# -------------------------------------
# 🐍 Python & Django Git Ignore Template
# -------------------------------------

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
venv/
env/
ENV/
.venv/
.pytest_cache/
pip-log.txt
pip-delete-this-directory.txt

# Django stuff
*.log
*.pot
*.pyc
*.pyo
*.pyd
db.sqlite3
media/
staticfiles/
static/
local_settings.py

# VSCode & IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Environment variables
.env
.env.*
!example.env

# Build / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# Coverage / testing
.coverage
.tox/
nosetests.xml
coverage.xml
*,cover
.hypothesis/
htmlcov/

# PyCharm specific
*.iml
*.ipr
*.iws

# Jupyter / notebooks
.ipynb_checkpoints

# macOS / Linux / Windows system files
.DS_Store
Thumbs.db
ehthumbs.db
Icon?
desktop.ini

# Temporary files
*.swp
*.bak
*.tmp
*.temp
*.log

# Node.js / frontend build files
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# -------------------------------------
# 🧠 Custom Project Specific
# -------------------------------------
# Ignore OpenAI cache / credentials
.openai_key
openai_cache/
ai_temp/
